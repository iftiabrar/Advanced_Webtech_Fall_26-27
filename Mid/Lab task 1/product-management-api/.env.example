# ---------- App ----------
PORT=5000
NODE_ENV=development
APP_ENV=local

# ---------- PostgreSQL (this is the "connect" part) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=user_management

# ---------- Required by src/config/app.config.ts (dummy values are fine) ----------
JWT_BEARER_SECRET=my_dev_jwt_secret_key
MAILER_HOST=smtp.example.com
MAILER_PORT=587
MAILER_SECURE=false
MAILER_USER=test@example.com
MAILER_PASSWORD=dummy_mail_password
MAILER_FROM=test@example.com

# ---------- Redis (not needed for the users module) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
